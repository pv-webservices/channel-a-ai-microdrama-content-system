{
  "name": "channel-a-ai-microdrama-content-system",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "studio": "remotion studio remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "validate:manifests": "node scripts/validate-remotion-manifests.mjs",
    "remotion:check": "remotion compositions remotion/index.ts --props=remotion/smoke/default.json",
    "validate": "npm run validate:manifests && npm run typecheck && npm run remotion:check",
    "render": "remotion render remotion/index.ts MicroDramaShort renders/microdrama.mp4",
    "render:vid-0001": "remotion render remotion/index.ts MicroDramaShort renders/VID-0001.mp4 --props=remotion/data/VID-0001.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.522"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}